<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewmodel"
            type="com.darusc.mousedroid.viewmodels.TouchpadViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark"
        android:padding="16dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Media Remote"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <GridLayout
            android:id="@+id/mediaGrid"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="40dp"
            android:columnCount="3"
            android:rowCount="3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title">

            <ImageButton
                android:id="@+id/btnReplay10"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/rounded_control"
                android:onClick="@{viewmodel::onMediaButtonClick}"
                android:src="@drawable/ic_replay_10"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/rounded_control"
                android:onClick="@{viewmodel::onMediaButtonClick}"
                android:src="@drawable/ic_skip_previos"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnForward10"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/rounded_control"
                android:onClick="@{viewmodel::onMediaButtonClick}"
                android:src="@drawable/ic_forward_10"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnVolDown"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/rounded_control"
                android:onClick="@{viewmodel::onMediaButtonClick}"
                android:src="@drawable/ic_volume_down"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/rounded_control"
                android:onClick="@{viewmodel::onMediaButtonClick}"
                android:src="@drawable/ic_play_pause"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnVolUp"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/rounded_control"
                android:onClick="@{viewmodel::onMediaButtonClick}"
                android:src="@drawable/ic_volume_up"
                app:tint="@color/white" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1" />

            <ImageButton
                android:id="@+id/btnVolOff"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/rounded_control"
                android:onClick="@{viewmodel::onMediaButtonClick}"
                android:src="@drawable/ic_volume_off"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/rounded_control"
                android:onClick="@{viewmodel::onMediaButtonClick}"
                android:src="@drawable/ic_skip_next"
                app:tint="@color/white" />
        </GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
